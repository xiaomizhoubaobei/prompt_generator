# ============================================================
# 安全架构说明（v2 - 服务端托管密钥）
# ------------------------------------------------------------
# 本应用已升级为「前端 + 服务端 BFF」架构：
# - 真实上游 AI 网关的 API Key 由【服务端】持有，仅从服务端环境变量
#   UPSTREAM_API_KEY 读取，绝不注入前端 bundle、绝不写入源码；
# - 前端不在浏览器中持久化/持有任何 API Key，也不存在静态密钥常量；
# - 前端先经 /api/session 建立短期会话（HttpOnly Cookie + 签名 Token，
#   仅存于浏览器堆内存），AI 调用经 /api/proxy/* 由服务端代理并注入密钥；
# - VITE_* 前缀变量会随前端 bundle 分发，严禁用于承载任何密钥。
# ============================================================

# Whether to show the 302 AI brand
VITE_APP_SHOW_BRAND=false

# Set the ai model you want to use
VITE_APP_MODEL_NAME=gpt-4o
# 0 for China, 1 for Global
VITE_APP_REGION=0
# Set the locale you want to use, zh for Chinese, en for English, ja for Japanese
VITE_APP_LOCALE=zh
# The url of the 302 AI official website
VITE_APP_OFFICIAL_WEBSITE_URL_CHINA=https://302ai.cn/
VITE_APP_OFFICIAL_WEBSITE_URL_GLOBAL=https://302.ai/

# The url of the 302 AI upload API（图片上传，不涉及 API Key）
VITE_APP_UPLOAD_API_URL=https://dash-api.302.ai/gpt/api/upload/gpt/image

# Docker / nginx 对外端口
PORT=3000

# ============================================================
# 服务端 BFF 配置（仅后端进程读取，绝不注入前端 bundle）
# 这些变量必须配置在服务端运行环境（.env / docker-compose / 部署平台），
# 不得带 VITE_ 前缀，否则会随前端产物泄露。
# ============================================================
# 上游 AI 网关基础地址（默认 302.AI）
UPSTREAM_API_URL=https://api.302.ai
# 真实上游 API Key：服务端唯一持有并注入的地方，务必配置
UPSTREAM_API_KEY=
# 短期会话签名密钥：应为足够随机的强口令（openssl rand -hex 32）
SESSION_SECRET=
# BFF 监听端口（容器内部），nginx 已配置 /api 转发到该端口
SERVER_PORT=3001

# -----------------------------------------------------------------------------
# Issue 开启钉钉通知（.github/workflows/dingtalk-issue-notify.yml）
# 说明：以下两个是 GitHub Actions Secrets，仅供工作流读取，不参与前端构建，
#      此处只留空占位、不加任何真实值。请勿在此提交真实凭据。
# -----------------------------------------------------------------------------
# 钉钉群机器人 Webhook 完整地址（形如 https://oapi.dingtalk.com/robot/send?access_token=xxx）
DINGTALK_WEBHOOK=
# 钉钉自定义机器人「安全设置 → 加签」的 SEC 密钥（用于 HMAC-SHA256 加签）
DINGTALK_SECRET=
